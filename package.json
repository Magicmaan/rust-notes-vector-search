{
	"name": "era",
	"version": "12.1.0",
	"description": "A modern Tauri desktop application with React, Vite, TypeScript, Shadcn UI and TailwindCSS",
	"license": "MIT",
	"author": {
		"name": "Guasam",
		"url": "https://github.com/guasam"
	},
	"scripts": {
		"web:dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
		"web:build": "vite build",
		"dev": "npm run tauri:dev",
		"start": "vite preview",
		"tauri:dev": "bash -lc \"cd src-tauri/app && tauri dev\"",
		"tauri:build": "bash -lc \"cd src-tauri/app && tauri build\"",
		"format": "prettier --write --list-different .",
		"lint": "eslint . --ext .ts,.tsx --fix",
		"tauri:build:release": "bash -lc \"cd src-tauri/app && tauri build\"",
		"tauri:dev:x11": "bash -lc \"cd src-tauri/app && GDK_BACKEND=x11 tauri dev\"",
		"tauri:dev:wayland": "bash -lc \"cd src-tauri/app && GDK_BACKEND=wayland WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev\"",
		"tauri:dev:wayland-safe": "bash -lc \"cd src-tauri/app && GDK_BACKEND=wayland WEBKIT_DISABLE_COMPOSITING_MODE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev\"",
		"tauri:run:x11": "GDK_BACKEND=x11 ./src-tauri/target/release/app",
		"tauri:run:wayland": "GDK_BACKEND=wayland WEBKIT_DISABLE_DMABUF_RENDERER=1 ./src-tauri/target/release/app",
		"tauri:dev:clean": "bash -lc \"fuser -k 5173/tcp 2>/dev/null || true; pkill -f 'tauri dev' 2>/dev/null || true; npm run tauri:dev\""
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/guasam/electron-react-app"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@project-lary/react-material-symbols-400-rounded": "^0.37.0",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@tanstack/react-query": "^5.100.5",
		"@tanstack/react-query-devtools": "^5.100.5",
		"@tauri-apps/api": "^2.10.1",
		"@timohausmann/quadtree-ts": "^2.3.0",
		"@tiptap/markdown": "^3.22.4",
		"@tiptap/pm": "^3.22.4",
		"@tiptap/react": "^3.22.4",
		"@tiptap/starter-kit": "^3.22.4",
		"@uidotdev/usehooks": "^2.4.1",
		"base-ui": "^0.0.294",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"immer": "^11.1.4",
		"motion": "^12.38.0",
		"neverthrow": "^8.2.0",
		"radix-ui": "^1.4.3",
		"react-cookie": "^8.1.0",
		"react-draggable": "^4.5.0",
		"react-grid-layout": "^2.2.3",
		"react-resizable": "^3.1.3",
		"react-rnd": "^10.5.3",
		"react-router": "^7.14.2",
		"react-router-dom": "^7.14.2",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"use-sync-external-store": "^1.6.0",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.6.0",
		"wasm": "file:packages/wasm/pkg",
		"zod": "^4.3.6",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@eslint/js": "^9.39.4",
		"@rushstack/eslint-patch": "^1.16.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.4",
		"@tauri-apps/cli": "^2.10.1",
		"@timohausmann/quadtree-js": "^1.2.6",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"eslint": "^9.39.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"framer-motion": "^12.38.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.8.3",
		"react": "^19.2.5",
		"react-devtools": "^7.0.1",
		"react-dom": "^19.2.5",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.1",
		"vite": "^7.3.2"
	}
}
