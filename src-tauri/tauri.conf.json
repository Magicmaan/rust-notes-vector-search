{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "rust-notes-vector-search",
	"version": "0.1.0",
	"identifier": "com.theo.notesvectorsearch",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://127.0.0.1:5173",
		"beforeDevCommand": "npm run web:dev",
		"beforeBuildCommand": "npm run web:build"
	},
	"app": {
		"windows": [
			{
				"title": "Notes Vector Search",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false,
				"devtools": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
